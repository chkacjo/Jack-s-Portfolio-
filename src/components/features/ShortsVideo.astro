---
interface Props {
	videoId: string;
	title: string;
}
const { videoId, title } = Astro.props;
---

<shorts-video data-video-id={videoId} data-title={title}>
	<button type="button" aria-label={`播放：${title}`}>
		<img
			src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
			alt=""
			loading="lazy"
			width="480"
			height="360"
		/>
		<span class="play-label"><span class="play-icon" aria-hidden="true">▶</span><span class="play-text">播放影片</span></span>
	</button>
</shorts-video>

<script>
	class ShortsVideo extends HTMLElement {
		connectedCallback() {
			const poster = this.querySelector("img");
			if (poster) {
				const hideFailedPoster = () => { poster.hidden = true; };
				poster.addEventListener("error", hideFailedPoster, { once: true });
				if (poster.complete && poster.naturalWidth === 0) hideFailedPoster();
			}
			this.querySelector("button")?.addEventListener("click", () => {
				document.dispatchEvent(new Event("jack:pause-music"));
				for (const other of document.querySelectorAll<HTMLIFrameElement>("shorts-video iframe")) {
					other.contentWindow?.postMessage(
						JSON.stringify({ event: "command", func: "pauseVideo", args: [] }),
						"https://www.youtube-nocookie.com",
					);
				}
				const iframe = document.createElement("iframe");
				const videoId = this.dataset.videoId;
				const src = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);
				src.searchParams.set("autoplay", "1");
				src.searchParams.set("playsinline", "1");
				src.searchParams.set("enablejsapi", "1");
				src.searchParams.set("origin", window.location.origin);
				iframe.src = src.href;
				iframe.title = this.dataset.title || "剪輯作品";
				iframe.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture";
				iframe.allowFullscreen = true;
				iframe.referrerPolicy = "strict-origin-when-cross-origin";
				this.replaceChildren(iframe);
			}, { once: true });
		}
	}
	if (!customElements.get("shorts-video")) customElements.define("shorts-video", ShortsVideo);
</script>

<style>
	shorts-video {
		display: block;
		width: min(100%, 380px, calc(76svh * 9 / 16));
		min-width: 200px;
		aspect-ratio: 9 / 16;
		overflow: hidden;
		border-radius: 1.25rem;
		background: #122021;
		box-shadow: 0 16px 48px #0003;
	}
	button {
		position: relative;
		width: 100%;
		height: 100%;
		cursor: pointer;
		background: linear-gradient(150deg, #244d4d, #10191d);
	}
	button:focus-visible { outline: 3px solid var(--primary); outline-offset: -5px; }
	img { width: 100%; height: 100%; object-fit: cover; opacity: .75; transition: transform .25s ease, opacity .25s ease; }
	button:hover img { transform: scale(1.025); opacity: .9; }
	.play-label {
		position: absolute; inset: 0; display: flex; align-items: center; flex-direction: column;
		justify-content: center; gap: .7rem; color: white; font-weight: 700;
		background: linear-gradient(transparent, #0006);
	}
	.play-icon {
		display: grid; place-items: center; height: 3.5rem; width: 3.5rem;
		border-radius: 50%; background: #ffffff28; backdrop-filter: blur(10px);
	}
	.play-text { font-size: .8125rem; letter-spacing: .05em; }
	@media (prefers-reduced-motion: reduce) { img { transition: none; } button:hover img { transform: none; } }
	shorts-video :global(iframe) { width: 100%; height: 100%; border: 0; }
</style>
