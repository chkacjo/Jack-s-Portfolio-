---
import { musicPlayerConfig } from "@/config/musicConfig";
import AudioPlayer from "./AudioPlayer.astro";
import YouTubeMusic from "./YouTubeMusic.astro";

interface Props {
	class?: string;
	style?: string;
	id?: string;
}
---

{musicPlayerConfig.mode === "youtube" && musicPlayerConfig.youtube ? (
	<YouTubeMusic {...musicPlayerConfig.youtube} />
) : (
	<AudioPlayer {...Astro.props} />
)}
