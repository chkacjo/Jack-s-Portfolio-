---
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ShortsVideo from "@/components/features/ShortsVideo.astro";
import { editingWorks } from "@/data/edits";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="剪輯" description="Jack 的短影音剪輯作品。">
	<div class="edits-page">
		<Markdown class="edits-typography">
			<header class="page-intro">
				<div class="intro-heading"><h1>剪輯</h1><span class="collection-count">{String(editingWorks.length).padStart(2, "0")} 支影片</span></div>
			</header>
			<section class="works" aria-label="剪輯作品">
				{editingWorks.map((work, index) => (
					<article class="work card-base" id={work.id}>
						<header class="work-copy">
							<div class="work-heading">
								<span class="work-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
								<h2>{work.title}</h2>
							</div>
							<div class="work-meta">
								<a href={`https://www.youtube.com/shorts/${work.videoId}`} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}的原始頻道與觀看數`}>YTR：<span data-channel-for={work.videoId}>{work.channelName ?? "原頻道 ↗"}</span></a>
								<span class="meta-divider" aria-hidden="true">/</span>
								<span>{work.viewCount === null ? "觀看數以 YouTube 為準" : `觀看數：${typeof work.viewCount === "number" ? work.viewCount.toLocaleString("zh-TW") : work.viewCount}`}</span>
							</div>
							<p class="clip-caption">{work.description}</p>
						</header>
						<div class="video-stage not-prose"><ShortsVideo videoId={work.videoId} title={work.title} /></div>
						<footer class="work-footer not-prose"><span>9:16 <span aria-hidden="true">·</span> YouTube Shorts</span><a href={`https://www.youtube.com/shorts/${work.videoId}`} target="_blank" rel="noopener noreferrer" aria-label={`在 YouTube 開啟${work.title}`}>開啟影片 <span aria-hidden="true">↗</span></a></footer>
					</article>
				))}
				<article class="work work-placeholder card-base" aria-label="更多剪輯作品準備中">
					<header class="work-copy">
						<div class="work-heading">
							<span class="work-index" aria-hidden="true">{String(editingWorks.length + 1).padStart(2, "0")}</span>
							<h2>下一支作品，慢慢剪</h2>
						</div>
						<p class="clip-caption">剪輯新手，作品還不多，正在一支一支累積中。</p>
					</header>
					<div class="video-stage not-prose">
						<div class="video-placeholder">
							<Icon is:inline name="material-symbols:movie-edit-outline" class="placeholder-icon" aria-hidden="true" />
							<strong>練習中，敬請期待</strong>
							<p>從每一次剪接，<br />慢慢找到自己的節奏。</p>
						</div>
					</div>
					<footer class="work-footer not-prose"><span>持續學習 <span aria-hidden="true">·</span> 持續更新</span></footer>
				</article>
			</section>
		</Markdown>
	</div>
</MainGridLayout>

<style>
	.edits-page { position: relative; z-index: 30; container-type: inline-size; width: 100%; max-width: 75rem; margin: 0 auto; padding: 0 1rem 2rem; }
	.page-intro { margin-bottom: 1.75rem; }
	.intro-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.intro-heading h1 { margin: 0; }
	.collection-count { color: var(--content-meta); font-size: .75rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
	.works { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
	.work { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border-radius: var(--radius-large); border: 1px solid var(--line-divider); }
	.work-copy { padding: 1.5rem 1.25rem 1.125rem; }
	.work-heading { display: flex; align-items: center; gap: .625rem; }
	.work-heading h2 { margin: 0; font-size: 1.125rem; line-height: 1.5; }
	.work-index { font-size: .6875rem; color: var(--primary); font-weight: 700; font-variant-numeric: tabular-nums; }
	.work-meta { display: flex; align-items: baseline; flex-wrap: wrap; gap: .375rem; margin-top: .75rem; font-size: .8125rem; color: var(--content-meta); overflow-wrap: anywhere; }
	.meta-divider { opacity: .4; }
	.clip-caption { margin: .5rem 0 0; font-size: .875rem; line-height: 1.8; }
	.video-stage { display: flex; justify-content: center; margin-top: auto; padding: 0 1.25rem; }
	.video-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; width: min(100%, 380px, calc(76svh * 9 / 16)); aspect-ratio: 9 / 16; padding: 1.5rem; border: 1px dashed var(--line-divider); border-radius: 1.25rem; background: var(--btn-regular-bg); color: var(--content-meta); text-align: center; }
	.video-placeholder .placeholder-icon { font-size: 3rem; color: var(--primary); }
	.video-placeholder strong { color: var(--primary); font-size: .9375rem; }
	.video-placeholder p { margin: 0; font-size: .8125rem; line-height: 1.8; }
	.work-footer { min-height: 3.625rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; margin: 1rem 1.25rem 0; padding: .875rem 0 1rem; border-top: 1px solid var(--line-divider); font-size: .75rem; color: var(--content-meta); }
	.work-footer a { color: var(--primary); font-weight: 600; padding: .25rem 0; }
	.work-footer a:hover { text-decoration: underline; }
	@container (min-width: 35rem) {
		.works { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@container (min-width: 56rem) {
		.works { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (max-width: 640px) {
		.edits-page { padding: 0 .5rem 1rem; }
		.work-copy { padding: 1.25rem 1rem 1rem; }
		.video-stage { padding: 0 1rem; }
		.work-footer { margin-inline: 1rem; }
	}
</style>
