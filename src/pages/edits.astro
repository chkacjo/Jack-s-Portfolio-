---
import Markdown from "@/components/common/Markdown.astro";
import ShortsVideo from "@/components/features/ShortsVideo.astro";
import Footer from "@/components/layout/Footer.astro";
import HeaderTopRow from "@/components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@/components/layout/NavMenuPanel.astro";
import { navbarMode, siteConfig } from "@/config";
import { editingWorks } from "@/data/edits";
import Layout from "@/layouts/Layout.astro";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
---

<Layout title="剪輯" description="短影音展示測試頁。所列影片僅供版面與播放測試，並非 Jack 的剪輯成果。">
	<HeaderTopRow navbarMode={navbarMode} navbarWidthFull={siteConfig.navbar.widthFull ?? false} />
	<main id="swup-container" class="edits-page">
		<Markdown class="edits-typography">
			<header class="page-intro">
				<h1>剪輯</h1>
				<p>以下影片僅供版面與播放測試，並非我的剪輯成果。</p>
			</header>
			<section class="works" aria-label="剪輯測試影片">
				{editingWorks.map((work) => (
					<article class="work card-base" id={work.id}>
						<header class="work-copy">
							<h2>{work.title}</h2>
							<p class="clip-caption">
								<a href={`https://www.youtube.com/shorts/${work.videoId}`} target="_blank" rel="noopener noreferrer" aria-label={`${work.title}的原始頻道與觀看數`}>YTR：<span data-channel-for={work.videoId}>{work.channelName ?? "原頻道 ↗"}</span></a>
								<span> · {work.viewCount === null ? "觀看數以 YouTube 為準" : `觀看數：${typeof work.viewCount === "number" ? work.viewCount.toLocaleString("zh-TW") : work.viewCount}`}</span>
								<span> · {work.description}</span>
							</p>
						</header>
						<div class="video-stage not-prose"><ShortsVideo videoId={work.videoId} title={work.title} /></div>
					</article>
				))}
			</section>
		</Markdown>
	</main>
	<Footer />
	<NavMenuPanel links={resolveNavMenuLinks()} />
</Layout>

<style>
	.edits-page { position: relative; z-index: 30; --shorts-width: max(200px, min(380px, calc(76svh * 9 / 16))); max-width: calc(var(--shorts-width) + 4rem); margin: 0 auto; padding: 7rem 1.5rem 2rem; }
	.page-intro { margin-bottom: 2rem; }
	.works { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
	.work { overflow: hidden; border-radius: var(--radius-large); }
	.work-copy { padding: 1rem; }
	.work-copy h2 { margin-top: 0; margin-bottom: .75rem; }
	.clip-caption { margin: 0; font-size: .875rem; line-height: 1.8; }
	.video-stage { display: flex; justify-content: center; padding: 0 .5rem .5rem; }
	@media (max-width: 640px) {
		.edits-page { max-width: calc(var(--shorts-width) + 3rem); padding: 6rem 1rem 1rem; }
	}
</style>
